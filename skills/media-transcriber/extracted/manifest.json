{
  "code": "media-transcriber",
  "version": "1.1.0",
  "type": "skill",
  "displayName": "音视频转录与长文整理",
  "description": "把音视频、播客、字幕或逐字稿整理成保留案例、数字和推理过程的中文长稿，可按需提供摘要、真实时间戳和原始逐字稿。",
  "runtimeTargets": [
    "A",
    "B",
    "C",
    "D",
    "F"
  ],
  "examplePrompts": [
    "帮我把这期播客整理成完整中文长稿，保留案例、数字和推理过程。",
    "把这段访谈整理成长稿，并在开头加一段简短摘要。",
    "把这段会议录音整理成带真实时间戳的长稿，方便回听核对。",
    "只给我这段录音的原始逐字稿，保留原语言和发言顺序，不删口水话。",
    "把这个视频整理成飞书文档，使用我已授权的飞书账号创建新文档。"
  ],
  "itCanHelpYou": [
    "把播客、视频或会议逐字稿整理成保留细节的中文长稿。",
    "按需生成简短摘要、带真实时间戳的整理稿或原始逐字稿。",
    "首次使用时检查本次任务所需的工具，并说明缺少的依赖。",
    "默认交付 Markdown；已授权时可创建并核对飞书文档。"
  ],
