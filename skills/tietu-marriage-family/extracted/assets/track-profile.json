  "images": {
    "visualStrategy": {
      "selectionBasis": "topic-first",
      "dynamicSelection": true,
      "family": "documentary",
      "defaultMode": "documentary_illustration",
      "allowedModes": [
        "source_photo",
        "source_crop",
        "documentary_illustration",
        "text_card"
      ],
      "defaultSourcePriority": "can_generate",
      "routingRule": "采用匿名家庭纪实场景和生活物件表达关系，不还原真实当事人，不用夸张冲突摆拍。"
    },
    "finishedOutput": {
      "directBitmap": true,
      "format": "png",
      "defaultOverlayMode": "title",
      "allowedOverlayModes": [
        "none",
        "title",
        "title_and_annotations"
      ],
      "overlayDecisionRule": "先判断本图靠真实画面成立，还是必须靠一句文字成立；实拍证据图选 none，观点或情绪入口才选 title，需要解释局部才选 title_and_annotations。默认值只是兜底，不得覆盖本次主题判断。"
    },
    "defaultMin": 1,
    "defaultMax": 2,
    "extendedMax": 5,
    "exceptionKinds": [
      "real_life_sequence",
      "conversation_context",
      "family_routine"
    ],
    "visualHook": {
      "stopReason": "用人物距离、目光和手的方向，再加一个没做完的家务或家庭物件，表现关系正卡在哪一步。",
      "hookVariants": [
        {
          "id": "relationship-distance",
          "useWhen": "主题讲沟通、冷淡、争执后的停顿或修复",
          "visualHook": "人物之间的空间、朝向和一个被打断动作承担冲突。"
        },
        {
          "id": "shared-work",
          "useWhen": "主题讲家庭分工、亲子学习或照料",
          "visualHook": "谁在做什么、另一个人在哪里，通过锅、作业本、书包等物件看见。"
        },
        {
          "id": "boundary-object",
          "useWhen": "主题讲婆媳、钱、手机或家庭边界",
          "visualHook": "一个共同物件放在两人之间，手的去向比表情更重要。"
        }
      ],
      "prioritySignals": [
        "人物之间的实际距离",
        "目光、手和身体朝向",
        "一个未完成的家庭动作",
        "作业本、饭菜、钥匙或手机等关系证据",
        "孩子或老人照料留下的物件",
        "谁在做哪一步的分工信息"
      ],
      "preferredMoments": [
        "一方端走碗而另一方仍看作业本",
        "钥匙递到一半却没有接",
        "手机被扣在桌面后两人停住",
        "门口只剩一双刚换下的鞋",
        "家长会材料刚整理到一半"
      ],
      "compositionBias": [
        "两个人不必同时露脸，物件放在关系中心",
        "利用距离和朝向，不靠夸张表情",
        "标题区不能盖住手、饭菜、作业本等关键证据"
      ],
      "authenticityTraces": [
        "放凉的汤",
        "没收好的书包",
        "鞋柜杂物",
        "餐桌水印与碗筷",
        "衣物褶皱和轻微运动模糊"
      ],
      "avoidGenericScenes": [
        "影楼情侣照和精致家庭合影",
        "沙发两端的固定冷战模板",
        "夸张哭喊、摔东西和脸谱化恶人",
        "所有家庭都用暖黄灯和豪华客厅",
        "用性别化服装和姿态暗示谁对谁错"
      ],
      "topicAdaptationRule": "先从当前主题选择一段关系动作和一个家庭证据，再决定人物数量、距离与环境；不同主题切换餐桌、玄关、楼道、接送或社区场景。",
      "colorRule": "使用家庭当下真实光线和普通肤色，不用偶像剧调色或影楼磨皮。",
      "overlayBias": "情绪关系常需代码叠一行标题；如果动作和物件已足够清楚则纯图。",
      "promptAssemblyOrder": [
        "topicHook",
        "subjectState",
        "singleAction",
        "evidenceDetail",
        "ordinaryEnvironment",
        "authenticityTraces",
        "compositionGoal",
        "overlayDecision",
        "factBoundary",
        "negativeConstraints"
      ]
    },
    "referenceImageRouting": {
      "modes": [
        "use_original",
        "light_transform",
        "style_reference",
        "similar_search"
      ],
      "defaultMode": "style_reference",
      "decisionRule": "用户明确选择优先；未说明授权时不直接复用网络对标图，默认提取视觉规律后重新生成。",
      "originalUseBoundary": "原图使用仅限用户自有、已授权或明确允许复用的素材。",
      "similarSearchRule": "拆成主体、动作、环境、质感和构图检索词，保留来源与授权信息，再由用户选择。"
    },
