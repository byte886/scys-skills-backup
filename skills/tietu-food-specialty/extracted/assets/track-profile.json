{
  "schemaVersion": 1,
  "skillName": "tietu-food-specialty",
  "trackId": "food-specialty",
  "trackName": "贴图号·美食特产",
  "persona": {
    "age": 46,
    "gender": "女性",
    "identity": "做过社区团购和小吃摊帮工的菜市场熟客",
    "values": [
      "尊重地方做法和摊贩劳动",
      "先看食物状态与安全，再谈流量和好不好吃",
      "诚实区分看着想尝、实际吃过、未吃过和不敢吃"
    ]
  },
  "body": {
    "countUnit": "CJK ideographs",
    "absoluteMaxChineseChars": 1000,
    "modes": {
      "standard": {
        "label": "标准模式",
        "minChineseChars": 80,
        "maxChineseChars": 1000,
        "preferredMinChineseChars": 200,
        "preferredMaxChineseChars": 300
      },
      "story": {
        "label": "故事或来历模式",
        "minChineseChars": 80,
        "maxChineseChars": 1000,
        "preferredMinChineseChars": 500,
        "preferredMaxChineseChars": 800
      }
    }
  },
  "images": {
    "visualStrategy": {
      "selectionBasis": "topic-first",
      "dynamicSelection": true,
      "family": "source-first",
      "defaultMode": "source_photo",
      "allowedModes": [
        "source_photo",
        "source_crop",
        "documentary_illustration",
        "process_sequence"
      ],
      "defaultSourcePriority": "prefer_source",
      "routingRule": "优先使用同一食物、同一批次的实拍原图和切面；没有来源图时只能生成明确标注为画面示意的普通食物场景。"
    },
    "finishedOutput": {
      "directBitmap": true,
      "format": "png",
      "defaultOverlayMode": "none",
      "allowedOverlayModes": [
        "none",
        "title",
        "title_and_annotations"
      ],
      "overlayDecisionRule": "先判断本图靠真实画面成立，还是必须靠一句文字成立；实拍证据图选 none，观点或情绪入口才选 title，需要解释局部才选 title_and_annotations。默认值只是兜底，不得覆盖本次主题判断。"
    },
    "defaultMin": 1,
    "defaultMax": 2,
    "extendedMax": 5,
    "exceptionKinds": [
      "food_process",
      "food_safety_comparison",
      "origin_to_product"
    ],
    "visualHook": {
      "stopReason": "第一眼先让食材产生食欲和好奇：要么单个食材饱满、有切面张力，要么丰富陈列琳琅满目。",
      "hookVariants": [
        {
          "id": "single-ingredient-tension",
          "useWhen": "单个瓜果、食材、点心或切面本身足够特别",
          "visualHook": "主体大而饱满，突出表皮、切面、汁水、馅料或刚掰开的瞬间。"
        },
        {
          "id": "rich-assortment",
          "useWhen": "主题讲集市、时令、多品种或地方特产集合",
          "visualHook": "不同颜色、大小和形状自然堆叠，形成琳琅满目的节奏，但保持真实摊位逻辑。"
        },
        {
          "id": "handmade-action",
          "useWhen": "主题讲制作或现做现卖",
          "visualHook": "切、掰、翻、包、称重中的一个动作与食物质地同时出现。"
        }
      ],
      "prioritySignals": [
        "饱满体积与真实重量感",
        "切面、裂口、汁水或馅料",
        "食材自身形成的颜色对比",
        "不完全一致的大小与形状",
        "一只手正在切、掰、挑或称",
        "丰富陈列的前后堆叠层次"
      ],
      "preferredMoments": [
        "刚掰开或刚切开的瞬间",
        "一筐食材自然溢满画面",
        "不同品种在摊位上交错陈列",
        "手从一堆食材中挑起一个",
        "刚出锅后表面仍有真实油光或碎屑"
      ],
      "compositionBias": [
        "单食材路线让主体占画面约三分之二以上并允许边缘被切到",
        "丰富路线用前中后层堆叠而不是整齐网格摆盘",
        "纯图铺满画面，不为标题预留空白"
      ],
      "authenticityTraces": [
        "水珠或泥点",
        "切板划痕",
        "碎屑和不规则边缘",
        "用过的竹筐或搪瓷盘",
        "摊布褶皱与轻微凌乱"
      ],
      "avoidGenericScenes": [
        "广告棚拍和高级餐厅摆盘",
        "蜡质塑料食物与假蒸汽",
        "所有食材同样大小且完美对称",
        "重饱和重锐化和统一暖滤镜",
        "为了好看凭空增加配菜、馅料或价签"
      ],
      "topicAdaptationRule": "先看当前主题的素材爆点属于单个食材张力、丰富陈列还是制作动作，再选择构图；食材、器皿、环境和动作都随主题变化，不固定餐桌或摊位。",
      "colorRule": "颜色以食材真实自然色为主，可丰富但不过度饱和，不使用重滤镜、商业调色或塑料高光。",
      "overlayBias": "默认纯图；食物本身能抓眼时禁止压标题，确需说明食安边界才代码添加短标签。",
      "promptAssemblyOrder": [
        "topicHook",
        "subjectState",
        "singleAction",
        "evidenceDetail",
        "ordinaryEnvironment",
        "authenticityTraces",
        "compositionGoal",
        "overlayDecision",
        "factBoundary",
        "negativeConstraints"
      ]
    },
    "referenceImageRouting": {
      "modes": [
        "use_original",
        "light_transform",
        "style_reference",
        "similar_search"
      ],
      "defaultMode": "style_reference",
      "decisionRule": "用户明确选择优先；未说明授权时不直接复用网络对标图，默认提取视觉规律后重新生成。",
      "originalUseBoundary": "原图使用仅限用户自有、已授权或明确允许复用的素材。",
      "similarSearchRule": "拆成主体、动作、环境、质感和构图检索词，保留来源与授权信息，再由用户选择。"
    },
    "typography": {
      "defaultStyle": "top-gradient",
      "allowedStyles": [
        "top-gradient",
        "white-bars",
        "outlined-center",
        "keyword-accent",
        "note-card"
      ],
      "recommendedStyles": [
        "outlined-center",
        "white-bars"
      ],
      "userSelectable": true,
      "customReferenceStyle": true,
      "styleOptions": [
        "placement",
        "align",
        "fontScale",
        "titleColor",
        "accentColor",
        "cardColor"
      ],
      "rule": "只有 overlayMode 不是 none 时才选择文字样式；先避开主体，再匹配标题长度和情绪，不按赛道机械固定。"
    },
    "promptVisibility": {
      "default": "internal_only",
      "allowed": [
        "internal_only",
        "admin_debug"
      ],
      "returnInUserOutput": false,
      "publicImageFields": [
        "role",
        "purpose",
        "sourceNotice",
        "overlayMode",
        "finalImage"
      ],
      "rule": "画图提示词只用于内部调用生图模型和质量校验；普通用户只看到完成图、来源说明和必要失败原因。"
    }
  },
