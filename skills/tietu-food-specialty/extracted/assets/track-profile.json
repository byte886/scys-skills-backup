  "aiTone": {
    "blockedPatterns": [
      {
        "label": "真正……从来不是……而是……的绝对化模板",
        "pattern": "真正[^。！？\\n]{0,28}从来不是[^。！？\\n]{0,60}而是"
      },
      {
        "label": "不仅是……更是……的整齐升华",
        "pattern": "不仅是[^。！？\\n]{0,32}更是"
      }
    ],
    "warningPatterns": [
      {
        "label": "万能乡愁或文化传承",
        "pattern": "(?:舌尖上的乡愁|承载着[^。！？\\n]{0,18}(?:乡愁|文化)|文化传承)"
      },
      {
        "label": "模板祝福或治愈",
        "pattern": "(?:愿(?:你|我们|每个|每一个|所有人)|治愈了?所有|温柔了?时光)"
      },
      {
        "label": "地方或人群泛化",
        "pattern": "(?:南方人|北方人|当地人都|家家户户|人人都|全省人|全国人)"
      }
    ]
  },
  "contentRisks": {
    "blockedPatterns": [
      {
        "label": "无来源第一人称品尝或偏好",
        "pattern": "(?:^|[，。；;！!？?])我(?:吃过|尝过|最爱|觉得好吃|吃得惯|一口下去)"
      },
      {
        "label": "无依据功效、毒性或食用结论",
        "pattern": "(?:降糖|补硒|防癌|抗癌|减肥|治病|一定有毒|一定能吃|切掉坏的就能吃)"
      },
      {
        "label": "危险热源做法",
        "pattern": "(?:塑料袋|报纸)[^。！？\\n]{0,18}(?:烤|加热|贴着热源|靠近电器|吹油烟)"
      },
      {
        "label": "地方或人群泛化",
        "pattern": "(?:南方人|北方人|当地人都|家家户户|人人都|全省人|全国人)"
      }
    ],
    "warningPatterns": [
      {
        "label": "未经上下文的正宗或最高级",
        "pattern": "(?:正宗|最地道|全国第一|全网第一|必吃|第一名|抢购一空|能发财)"
      },
      {
        "label": "价格缺少时间地点单位或规格",
        "pattern": "(?:\\d+|[一二三四五六七八九十]+)元(?![^。！？\\n]{0,24}(?:一斤|一袋|一份|一筐|规格|单位|当天|本地|地点|市场|年|月|日))"
      },
      {
        "label": "把看图推成口感",
        "pattern": "(?:入口即化|香甜可口|甜而不腻|清香扑鼻|软糯香甜|好吃到停不下来)"
      }
    ]
  },
